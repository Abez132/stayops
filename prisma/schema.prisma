generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  MANAGER
  CLEANER
  MAINTENANCE
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  STUDIO
  HOTEL
  GUESTHOUSE
  OTHER
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum CleaningTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum NotificationType {
  RESERVATION_CREATED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  GUEST_CHECKED_IN
  GUEST_CHECKED_OUT
  CLEANING_TASK_ASSIGNED
  CLEANING_TASK_COMPLETED
  MAINTENANCE_REQUEST_CREATED
  MAINTENANCE_REQUEST_RESOLVED
  GENERAL
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              OrganizationMember[]
  properties           Property[]
  guests               Guest[]
  reservations         Reservation[]
  cleaningTasks        CleaningTask[]
  maintenanceRequests  MaintenanceRequest[]
  notifications        Notification[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   OrganizationMember[]
  notifications Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// OrganizationMember  (User ↔ Organization with RBAC)
// ---------------------------------------------------------------------------

model OrganizationMember {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can only hold one role per organization
  @@unique([organizationId, userId])

  assignedCleaningTasks     CleaningTask[]       @relation("CleaningTaskAssignee")
  reportedMaintenanceTasks  MaintenanceRequest[] @relation("MaintenanceReporter")
  assignedMaintenanceTasks  MaintenanceRequest[] @relation("MaintenanceAssignee")

  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Property
// ---------------------------------------------------------------------------

model Property {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  slug               String
  description        String?
  propertyType       PropertyType
  address            String
  city               String
  country            String
  bedrooms           Int
  bathrooms          Int
  maxGuests          Int
  pricePerNight      Decimal        @db.Decimal(10, 2)
  currency           String         @default("USD")
  status             PropertyStatus @default(DRAFT)
  amenities          String[]
  checkInTime        String?        // e.g. "14:00"
  checkOutTime       String?        // e.g. "11:00"
  accessInstructions String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  images              PropertyImage[]
  reservations        Reservation[]
  cleaningTasks       CleaningTask[]
  maintenanceRequests MaintenanceRequest[]

  // Slug must be unique within an organization
  @@unique([organizationId, slug])

  @@map("properties")
}

// ---------------------------------------------------------------------------
// PropertyImage
// ---------------------------------------------------------------------------

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

// ---------------------------------------------------------------------------
// Guest
// ---------------------------------------------------------------------------

model Guest {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  // Same email can exist across orgs but not within one
  @@unique([organizationId, email])

  @@map("guests")
}

// ---------------------------------------------------------------------------
// Reservation
// ---------------------------------------------------------------------------

model Reservation {
  id             String            @id @default(cuid())
  organizationId String
  propertyId     String
  guestId        String
  checkIn        DateTime          @db.Date
  checkOut       DateTime          @db.Date
  guestsCount    Int
  status         ReservationStatus @default(PENDING)
  totalAmount    Decimal           @db.Decimal(10, 2)
  currency       String            @default("USD")
  specialRequests String?
  accessCode     String?
  accessInstructions String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest         Guest          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  cleaningTasks CleaningTask[]

  @@map("reservations")
}

// ---------------------------------------------------------------------------
// CleaningTask
// ---------------------------------------------------------------------------

model CleaningTask {
  id             String             @id @default(cuid())
  organizationId String
  propertyId     String
  reservationId  String
  assignedToId   String
  status         CleaningTaskStatus @default(PENDING)
  scheduledAt    DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation  Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  assignedTo   OrganizationMember @relation("CleaningTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@map("cleaning_tasks")
}

// ---------------------------------------------------------------------------
// MaintenanceRequest
// ---------------------------------------------------------------------------

model MaintenanceRequest {
  id             String              @id @default(cuid())
  organizationId String
  propertyId     String
  reportedById   String
  assignedToId   String?
  title          String
  description    String
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  completedAt    DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reportedBy   OrganizationMember  @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo   OrganizationMember? @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("maintenance_requests")
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
